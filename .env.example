# Core3 server settings. ./swgemu copies this to .env on first run and fills in
# random passwords. Edit .env, then run ./swgemu up to apply changes.

COMPOSE_PROJECT_NAME=swgemu

# --- Galaxy ------------------------------------------------------------------
GALAXY_NAME=Core3
# The address SWG clients connect to after logging in.
#   127.0.0.1    client runs on this same Windows PC (default)
#   192.168.x.y  friends on your LAN: use this PC's LAN IPv4 (ipconfig)
#   public IP    friends over the internet (forward UDP 44453, 44462, 44463)
GALAXY_ADDRESS=127.0.0.1
# Interface the server ports are published on. 0.0.0.0 = all.
BIND_IP=0.0.0.0
# Comma-separated account names that get admin level 15 (applied on start;
# accounts are created on first login). Or use: ./swgemu admin <name>
CORE3_ADMINS=

# --- TRE files ---------------------------------------------------------------
# Where the client .tre files live on this machine (mounted read-only).
TRE_DIR=./tre
# Where ./swgemu gets them if TRE_DIR is incomplete. Left empty on purpose:
# ./swgemu asks on first run and saves the answer to .env (git-ignored). Any of:
#   a Google Drive file link (shared as "Anyone with the link")
#   a .tar / .tar.gz / .zip path (Windows paths like C:\Users\me\Downloads\tre.tar work)
#   an SWG client install folder
TRE_SOURCE=

# --- Build -------------------------------------------------------------------
# RelWithDebInfo (recommended), Release, or Debug (much slower server).
BUILD_TYPE=RelWithDebInfo
# Parallel compile jobs. Empty = automatic (about 1 per 2GB of Docker memory).
BUILD_JOBS=
# Extra CMake flags, e.g. -DENABLE_NATIVE=OFF
CMAKE_EXTRA_ARGS=

# --- Runtime -----------------------------------------------------------------
# 1 = run core3 under gdb so crashes print a backtrace to ./swgemu logs.
CORE3_GDB=1
# -1 NONE, 0 FATAL, 1 ERROR, 2 WARNING, 3 LOG, 4 INFO, 5 DEBUG
LOG_LEVEL=4

# --- Secrets (generated on first run) ----------------------------------------
DB_PASS=
DB_ROOT_PASS=
DB_SECRET=
